{
  "name": "quotation-generator",
  "version": "1.7.0",
  "description": "Quotation generator for biometric products",
  "main": "dist/main/main.js",
  "scripts": {
    "copy-assets": "node scripts/copy-assets.js",
    "build": "tsc && npm run copy-assets",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "package": "npm run build && set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder --win nsis",
    "package:portable": "npm run build && set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder --win portable"
  },
  "keywords": ["electron", "quotation", "docx"],
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.techfinity.quotation-generator",
    "productName": "Lraxious' Quotation Generator v1.7",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quotation Generator",
      "artifactName": "QuotationGenerator-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "QuotationGenerator-portable.exe"
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "docx": "^8.5.0"
  }
}
